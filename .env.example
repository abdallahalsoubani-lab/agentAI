# OpenAI API Key
OPENAI_API_KEY=sk-...

# Database URL (SQLite for dev, Postgres for prod)
DATABASE_URL="file:./dev.db"
# For production Postgres:
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Admin password for embedded admin panel
ADMIN_PASSWORD=your_secure_admin_password

# Currency (JOD for Jordan, SAR for Saudi Arabia)
CURRENCY=JOD

# Prompts directory (default: ./prompts)
PROMPTS_DIR=./prompts

# App configuration
NEXT_PUBLIC_APP_NAME="Multi-Mode AI Assistant"
NEXT_PUBLIC_DEFAULT_MODE=mode1
